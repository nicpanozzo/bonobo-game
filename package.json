{
  "name": "bonobo-game",
  "version": "0.2.0",
  "private": true,
  "description": "Picchiaduro multiplayer online nel browser, fatto tra amici",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:godot": "godot --headless --path godot --script res://tests/run_tests.gd",
    "discord": "node scripts/discord.mjs",
    "bench": "tsx scripts/bench.ts",
    "balance": "tsx scripts/balance.ts",
    "bologna:bots": "tsx scripts/bologna-bots.ts",
    "audio:check": "tsx scripts/audio-check.ts",
    "bench:godot": "godot --headless --path godot --script res://tools/bench_client.gd",
    "export:godot": "tsx scripts/export-godot.ts",
    "midi:import": "tsx scripts/midi-import.ts",
    "host": "tsx src/server/host.ts",
    "build:server": "node scripts/build-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
